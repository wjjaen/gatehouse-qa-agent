# Required — Anthropic Claude API key for Design QA / Brand / SEO agents
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Set by Railway automatically — do not set manually on Railway
# PORT=3000

# Optional — set this AFTER deploying to Railway.
# Copy your Railway public URL here, then run: node build-dashboard.js
# This bakes the Railway URL into the static dashboard HTML so the live
# site (on Bluehost) can call scan/delete on the Railway backend.
RAILWAY_URL=https://your-app-name.up.railway.app
